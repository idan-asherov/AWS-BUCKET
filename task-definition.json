{
  "family": "claude-images-task-def",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "taskRoleArn": "arn:aws:iam::538379554611:role/ecsTaskRoleForS3",
  "executionRoleArn": "arn:aws:iam::538379554611:role/service-role/ecsTaskExecutionRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "538379554611.dkr.ecr.eu-north-1.amazonaws.com/claude-images-idan-asherov:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "main-3000-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "eu-north-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "aws-nodejs-idan-asherov"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "aws-nodejs-idan-asherov"
        },
        {
          "name": "PORT",
          "value": "3000"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/claude-images-container",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}